# =============================================================================
# AgentBreak Environment Configuration Template
# =============================================================================
# Copy this file to .env in the project root (or backend/) and fill in values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Database — PostgreSQL (required)
# -----------------------------------------------------------------------------
# Provide a full PostgreSQL connection string.
# Works with Render, Supabase, Neon, Railway, or any standard Postgres host.
#
# For Supabase, use the connection string from:
# Project Settings > Database > Connection string (URI)
#
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws.<region>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Auth (optional — enables user authentication)
# -----------------------------------------------------------------------------
# Found in Supabase Dashboard > Project Settings > API
#
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# JWT secret from Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=<your-jwt-secret>

# -----------------------------------------------------------------------------
# AI Model & API Configuration
# -----------------------------------------------------------------------------
# Optional: Live Gemini API key. If omitted, AgentBreak operates in 100%
# deterministic sandbox mock model mode with 0 external API calls and $0 cost.
GEMINI_API_KEY=

# Gemini target model identifier (default: gemini-2.0-flash)
GEMINI_MODEL_NAME=gemini-2.0-flash

# Default model adapter (mock or gemini)
DEFAULT_MODEL_ADAPTER=mock

# -----------------------------------------------------------------------------
# Security Thresholds & Policy Gates
# -----------------------------------------------------------------------------
REFUND_APPROVAL_THRESHOLD=50.0
REFUND_HARD_LIMIT=500.0

# -----------------------------------------------------------------------------
# Service Ports & Networking
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Next.js API endpoint pointing to FastAPI backend:
# For production, set this to your Render backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Allowed CORS origins (comma-separated or JSON list):
# For production, add your Vercel frontend URL
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional regex for Vercel preview deployments
CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.vercel\.app
