# =============================================================================
# AgentBreak Environment Configuration Template
# =============================================================================
# Copy this file to .env in your root directory or respective service directories.

# -----------------------------------------------------------------------------
# Database Configuration (Dual-Engine: PostgreSQL Online / SQLite Offline)
# -----------------------------------------------------------------------------
# For local offline development (default):
# Leave DATABASE_URL empty to use backend/data/agentbreak.db
DATABASE_URL=

# For online PostgreSQL production (Render, Supabase, Neon, etc.):
# DATABASE_URL=postgresql://user:password@hostname:5432/agentbreak_db

# Offline SQLite backup target file path:
SQLITE_BACKUP_PATH=backend/data/agentbreak_backup.db

# -----------------------------------------------------------------------------
# AI Model & API Configuration
# -----------------------------------------------------------------------------
# Optional: Live Gemini API key. If omitted, AgentBreak operates in 100%
# deterministic sandbox mock model mode with 0 external API calls and $0 cost.
GEMINI_API_KEY=

# Gemini target model identifier (default: gemini-2.0-flash)
GEMINI_MODEL_NAME=gemini-2.0-flash

# Default model adapter (mock or gemini)
DEFAULT_MODEL_ADAPTER=mock

# -----------------------------------------------------------------------------
# Security Thresholds & Policy Gates
# -----------------------------------------------------------------------------
REFUND_APPROVAL_THRESHOLD=50.0
REFUND_HARD_LIMIT=500.0

# -----------------------------------------------------------------------------
# Service Ports & Networking
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Next.js API endpoint pointing to FastAPI backend:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Allowed CORS origins (comma-separated or JSON list):
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
