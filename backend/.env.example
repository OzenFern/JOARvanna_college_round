# Backend Environment Configuration
# Default offline: uses SQLite at data/agentbreak.db
DATABASE_URL=
SQLITE_BACKUP_PATH=data/agentbreak_backup.db

# Online PostgreSQL connection string (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/agentbreak

# Gemini API Key (optional - per-request headers also supported)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
DEFAULT_MODEL_ADAPTER=mock

# Policy Thresholds
REFUND_APPROVAL_THRESHOLD=50.0
REFUND_HARD_LIMIT=500.0

# CORS Origins
CORS_ORIGINS=["*"]
